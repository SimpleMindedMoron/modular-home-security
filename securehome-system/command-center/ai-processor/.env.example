# HiveMQ Cloud Broker (TLS, works from any network)
MQTT_BROKER_HOST=xxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your-username
MQTT_PASS=your-password
MQTT_TLS=true

# MJPEG Stream Relay — exposes the camera stream to any network via ngrok
# Get your free authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken
RELAY_PORT=8765

# Default Camera Stream URL (Overridden dynamically if camera announces via discovery topic)
CAMERA_STREAM_URL=http://192.168.1.145:81/stream

# MQTT Topics
TOPIC_CAMERA_DISCOVERY=security/camera/discovery
TOPIC_CAMERA_RELAY=security/camera/relay_url
TOPIC_PERSON_ALERT=security/alerts/person

# Detection Settings
ALERT_COOLDOWN_SECONDS=10
MIN_CONFIDENCE=0.5

# Multi-Tenant Cloud Deployment (Optional)
# Enter your Claim Token copied from your web dashboard user profile
CLAIM_TOKEN=
DEVICE_UID=ESP32_CAM_01
